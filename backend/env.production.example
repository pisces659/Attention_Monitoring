# Render → Web Service → Environment
# Use Supabase connection string with asyncpg driver:
# postgresql+asyncpg://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

APP_ENV=production
API_PREFIX=/api/v1
DEV_AUTH_BYPASS=true

DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

CORS_ORIGINS=https://YOUR-APP.vercel.app,http://localhost:3000

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

STORAGE_BUCKET_RAW=raw-videos
STORAGE_BUCKET_ANNOTATED=annotated-videos
STORAGE_BUCKET_CSV=session-csv
